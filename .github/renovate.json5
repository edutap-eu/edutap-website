// Configuration for the Mend Renovate GitHub App (https://docs.renovatebot.com).
//
// The app must be installed for the `edutap-eu` organisation (or at least for
// this repository) — without it, this file has no effect. Renovate then opens
// a "Dependency Dashboard" issue listing every pending update, and raises pull
// requests according to the schedule of the shared preset. There is no
// workflow file for this: the hosted app runs Renovate on its own
// infrastructure.
//
// The rules every eduTAP repository wants — schedule, digest pins for GitHub
// Actions, weekly lock file maintenance, security labels, grouped dev tooling,
// Node.js on LTS majors only — live in the shared preset in
// edutap-eu/.github (renovate-config.json5). Only what names this
// repository's own packages stays here.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "github>edutap-eu/.github:renovate-config.json5",
    // Picks up `# renovate: datasource=… depName=…` comments in the workflow
    // files — used for the zizmor version in .github/workflows/zizmor.yaml,
    // which is an action input and invisible to the github-actions manager.
    "customManagers:githubActionsVersions",
  ],

  packageRules: [
    {
      // Astro and its official integrations are released in lockstep and are
      // only meaningful to review together.
      groupName: "Astro",
      matchPackageNames: ["astro", "@astrojs/**"],
    },
    {
      groupName: "Tailwind CSS",
      matchPackageNames: ["tailwindcss", "@tailwindcss/**"],
    },
    {
      groupName: "Sentry",
      matchPackageNames: ["@sentry/**"],
    },
  ],
}
