---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.data.slug.replace(/^\//, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Gatsby's page query formatted the date server-side with
// `date(formatString: "MMMM DD, YYYY")` — a zero-padded day, unlike the
// news index's non-padded `toLocaleDateString` formatting. Reproduced
// exactly here so the two pages keep their (pre-existing) formatting
// difference from the live site.
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<BaseLayout title={`${post.data.title} | eduTAP`} description={post.data.short}>
  <Container size="md" as="section" class="py-12 md:py-24">
    <div class="mb-8">
      <Button variant="ghost" size="sm" class="group" href="/news">
        <Icon
          name="lucide:arrow-left"
          class="h-4 w-4 mr-2 transition-transform group-hover:-translate-x-1"
        />
        <span class="-mb-px">Back to News</span>
      </Button>
    </div>

    <article>
      <header class="mb-8">
        <h1 class="text-5xl font-bold tracking-tight mb-6">
          {post.data.title}
        </h1>

        <div class="flex items-center">
          <div
            class="flex items-center bg-secondary/20 text-secondary-foreground px-3 py-1 rounded-md"
          >
            <Icon name="lucide:calendar" class="h-4 w-4 mr-2" />
            <span class="text-sm font-medium">{formattedDate}</span>
          </div>
        </div>
      </header>

      <div
        class="prose prose-lg max-w-none prose-headings:font-bold prose-a:text-primary"
      >
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>
