---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import NewsItem from "../../components/NewsItem.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("news");
const micro = await getCollection("microNews");

const items = [
  ...micro.map((entry) => ({ ...entry.data, isInternal: false })),
  ...posts.map((entry) => ({
    date: entry.data.date,
    title: entry.data.title,
    description: entry.data.short,
    url: `/news${entry.data.slug}`,
    isInternal: true,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout title="News | eduTAP">
  <Container size="md" as="section" class="py-12 md:py-24">
    <h1 class="text-5xl font-bold tracking-tight mb-12">News</h1>
    {
      items.length > 0 ? (
        items.map((item) => <NewsItem {...item} />)
      ) : (
        <div class="py-12 text-center">
          <h3 class="text-lg font-medium text-gray-500 mb-2">No news yet</h3>
          <p class="text-gray-400">
            Check back later for updates on the eduTAP project.
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
