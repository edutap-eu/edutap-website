---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Timeline from "../components/Timeline.astro";
import Milestone from "../components/Milestone.astro";
import { getCollection } from "astro:content";
import { byFileOrder } from "../lib/ordering";

// Recovers JSON file order from the loader's id, matching history.astro and
// the original roadmap.tsx (see history.astro for why getCollection()'s
// default id-string order and a parsed-date sort are both wrong here).
const milestones = (await getCollection("roadmap")).sort(byFileOrder);
---

<BaseLayout title="Roadmap | eduTAP">
  <Container size="md" as="section" class="py-12 md:py-36">
    <h1 class="mb-12 bg-white text-5xl font-bold tracking-tight">Roadmap</h1>
    <Timeline>
      {
        milestones.map((entry, index) => (
          <Milestone
            milestone={entry.data}
            side={index % 2 === 0 ? "left" : "right"}
          />
        ))
      }
    </Timeline>
  </Container>
</BaseLayout>
