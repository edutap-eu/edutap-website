---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Presentation from "../components/Presentation.astro";
import { getCollection } from "astro:content";

// The original presentations.tsx iterates allPresentationsJson.nodes in JSON
// file order and never sorts. getCollection() does NOT preserve that order on
// its own - it comes back sorted by `id` as a string ("presentation-0",
// "presentation-1", "presentation-10", ..., "presentation-2", ...), which
// scrambles all 33 cards. Sorting by the numeric suffix of the loader's own
// `${prefix}-${index}` id restores the file order the editors maintain and
// matches the live site.
const byFileOrder = (
  a: { id: string },
  b: { id: string },
) => Number(a.id.split("-").pop()) - Number(b.id.split("-").pop());

const presentations = (await getCollection("presentations")).sort(byFileOrder);

const lightningTalks = presentations.filter((entry) => entry.data.type === "lightning");
const conferenceTalks = presentations.filter(
  (entry) => entry.data.type === "conference" || entry.data.type === "webinar",
);
---

<BaseLayout title="Presentations | eduTAP">
  <Container size="md" as="section" class="py-12 md:py-24">
    <h1 class="text-5xl font-bold tracking-tight mb-12 text-center md:text-left">
      Presentations
    </h1>

    <div class="mb-24">
      <h2 class="text-3xl font-semibold pb-3 mb-8 border-b-4 border-primary inline-block">
        Lightning Talks
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {lightningTalks.map((entry) => <Presentation presentation={entry.data} />)}
      </div>
    </div>

    <div class="mb-8">
      <h2 class="text-3xl font-semibold pb-3 mb-8 border-b-4 border-primary inline-block">
        Conference & Webinar Talks
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {conferenceTalks.map((entry) => <Presentation presentation={entry.data} />)}
      </div>
    </div>
  </Container>
</BaseLayout>
