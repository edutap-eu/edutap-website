---
import Container from "./Container.astro";
import Button from "./ui/Button.astro";
import NavLinks from "./NavLinks.astro";
import GithubMark from "./GithubMark.astro";

const pathname = Astro.url.pathname;
---

<header
  class="backdrop-blur-md z-50 sticky top-0 bg-white/80 border-b border-gray-100"
>
  <Container class="py-4 transition-all duration-300">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-2 font-bold text-2xl transition-all duration-300"
      >
        <img src="/edutap-signet.svg" alt="" class="size-10" />
        <span
          ><span class="text-primary">edu</span><span class="text-accent"
            >TAP</span
          ></span
        >
      </a>

      <!-- inline navigation on >= md -->
      <div class="hidden md:flex">
        <NavLinks pathname={pathname} />
      </div>

      <div class="flex items-center space-x-2">
        <Button
          variant="outline"
          size="sm"
          href="https://docs.edutap.eu/"
          target="_blank"
          rel="noreferrer"
          class="hidden md:flex"
        >
          Documentation
        </Button>
        <Button
          variant="outline"
          size="sm"
          href="https://demo.edutap.eu/"
          target="_blank"
          rel="noreferrer"
        >
          Demo
        </Button>
        <Button
          size="sm"
          href="https://github.com/edutap-eu"
          target="_blank"
          rel="noreferrer"
          class="bg-black text-white hover:bg-black/90 hidden md:flex"
        >
          <GithubMark class="mr-2 h-4 w-4" inverted /> GitHub
        </Button>
      </div>
    </div>
  </Container>

  <!-- scrolling navigation on < md -->
  <div class="flex md:hidden overflow-auto no-scrollbar py-4 px-4">
    <NavLinks pathname={pathname} />
  </div>
</header>
