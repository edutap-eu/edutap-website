---
import Container from "../Container.astro";
import Badge from "../ui/Badge.astro";
import { Icon } from "astro-icon/components";
---

<Container size="lg" as="section" class="py-16 md:py-36 items-center">
  <h2 class="scroll-m-20 text-4xl font-bold tracking-tight text-center mb-16">
    <span class="text-primary">One Tap.</span>{" "}
    <span class="text-accent">Many Possibilities.</span>
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
    <div class="rounded-lg shadow-md bg-gradient-to-br from-primary to-primary/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:user-circle" size={48} class="inline-block mr-2" />tap to identify</h3>
      <p>
        Quickly verify your identity with a simple tap of your device. With
        Selective Disclosure Verifiable Credentials, you control what
        information to share.
      </p>
      <p>On and off campus, to access a variety of services and locations.</p>
    </div>

    <div class="rounded-lg shadow-md bg-gradient-to-br from-accent to-accent/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:key" size={48} class="inline-block mr-2" />tap to open a door</h3>
      <p>
        with the tap of a device, unlock secure access to:
      </p>
      <ul class="list-disc list-inside mt-2">
        <li>buildings</li>
        <li>class rooms</li>
        <li>labs</li>
        <li>computer rooms</li>
        <li>learning spaces</li>
        <li>parking garages</li>
        <li>dorm rooms</li>
        <li>athletic facilities</li>
        <li>and more...</li>
      </ul>
    </div>

    <div class="rounded-lg shadow-md bg-gradient-to-br from-primary to-primary/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:credit-card" size={48} class="inline-block mr-2" />tap to pay</h3>
      <p>
        You can use your device to pay almost anywhere. At campus dining,
        vending machines, printers, bookstores, and more - on and off campus.
      </p>
      <p>
        A single or a double tap - to prove your status and claim your
        discount - is all it takes.
      </p>
      <p>All possible payment methods are supported:</p>
      <ul class="list-disc list-inside mt-2">
        <li>your regular credit or debit card (open-loop payment)</li>
        <li>your campus prepaid card (closed-loop payment)</li>
        <li>coupons and vouchers</li>
      </ul>
    </div>

    <div class="rounded-lg shadow-md bg-gradient-to-br from-accent to-accent/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:book-open" size={48} class="inline-block mr-2" />tap to lend a book</h3>
      <p>
        Libraries with their books and media are the physical representation
        of knowledge and learning. With a simple tap, borrow books and other
        media.
      </p>
    </div>

    <div class="rounded-lg shadow-md bg-gradient-to-br from-primary to-primary/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:bus" size={48} class="inline-block mr-2" />tap to ride</h3>
      <p>
        Ride the campus shuttle or take the public transport.
        Also works for car, bike and scooter sharing.
      </p>
    </div>

    <div class="rounded-lg shadow-md bg-gradient-to-br from-accent to-accent/80 p-8 hover:shadow-lg transition-shadow text-white opacity-90 font-medium">
      <h3 class="text-xl font-bold mb-3"><Icon name="lucide:ticket-percent" size={48} class="inline-block mr-2" />tap to claim a discount</h3>
      <p>
        Claim a discount on campus and beyond, by proving your student status with a simple tap.
      </p>
    </div>
  </div>

  <p class="text-center text-xl text-gray-700 max-w-2xl mx-auto mt-16">
    All with the tap of your device. No app, no physical card, no hassle -
    just tap. All your passes and credentials in one place - your smartphone
    or wearable device - ready when you need them.
  </p>
  <p class="text-center">
    <Badge class="text-lg mb-6 px-8 py-2 mt-8 mx-auto">
      no app, <strong>just tap!</strong>
    </Badge>
  </p>
</Container>
