---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Container from "../Container.astro";
import { resolveTeamImage } from "../../lib/team-images";
import { byFileOrder } from "../../lib/ordering";

// getCollection() sorts ids as strings ("team-0", "team-1", "team-10", ...),
// which only happens to render correctly today because there are 8 members
// and every id is single-digit. byFileOrder recovers the team.json file
// order (the project lead is deliberately listed first) the same way
// history/roadmap/presentations already do. See src/lib/ordering.ts.
const members = (await getCollection("team")).sort(byFileOrder);
---

<Container size="sm" as="section" class="py-16 md:py-36">
  <h2 class="text-4xl font-bold tracking-tight text-center mb-16">
    Meet the Team
  </h2>

  <div
    class="grid gap-8 sm:gap-10 md:gap-12 px-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
  >
    {
      members.map((member) => {
        const { name, orgs, roles, image } = member.data;
        const orgsList = orgs ? orgs.join(" • ") : "";
        const rolesList = roles ? roles.join(" • ") : "";

        return (
          <div class="flex flex-col items-center group">
            <div class="relative w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 mb-4 overflow-hidden rounded-full">
              <Image
                alt={name}
                src={resolveTeamImage(image)}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              />
            </div>
            <div class="flex flex-col items-center text-center max-w-xs">
              <span class="font-bold text-base sm:text-lg mb-1">{name}</span>
              <span class="text-gray-600 text-xs sm:text-sm">{orgsList}</span>
              <span class="text-gray-600 text-xs sm:text-sm">{rolesList}</span>
            </div>
          </div>
        );
      })
    }
  </div>
</Container>
