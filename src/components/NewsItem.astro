---
import { cn } from "../lib/utils";
import Button from "./ui/Button.astro";

interface Props {
  date: Date;
  title: string;
  description: string;
  url?: string | null;
  isInternal?: boolean;
  class?: string;
}

const {
  date,
  title,
  description,
  url,
  isInternal = false,
  class: className = "",
} = Astro.props;

// Format date to a more readable format
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class={cn("border-b border-gray-200 py-6 last:border-0", className)}>
  <div class="text-sm text-gray-500 mb-2">{formattedDate}</div>
  <h3 class="text-xl font-semibold mb-2">{title}</h3>
  <p class="text-gray-700 mb-3">{description}</p>
  {
    url && isInternal ? (
      <Button variant="link" class="p-0" href={url}>
        Read more
      </Button>
    ) : (
      url && (
        <Button
          variant="link"
          class="p-0"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read more
        </Button>
      )
    )
  }
</div>
