---
import type { CollectionEntry } from "astro:content";

interface Props {
  presentation: CollectionEntry<"presentations">["data"];
}

const { presentation } = Astro.props;
const { title, file, description } = presentation;

const pdfPath = `/presentations/${file}`;
const thumbPath = `/presentations/thumbs/${file.replace(/\.pdf$/i, ".webp")}`;
---

<a
  href={pdfPath}
  target="_blank"
  rel="noreferrer"
  class="flex flex-col h-full overflow-hidden rounded-lg shadow-lg transition-transform duration-300 hover:shadow-xl hover:-translate-y-1 border border-gray-200 cursor-pointer"
>
  <div class="relative w-full h-48 bg-gray-100 overflow-hidden">
    <img
      src={thumbPath}
      alt={`First page of ${title}`}
      loading="lazy"
      decoding="async"
      width="400"
      class="h-full w-full object-cover object-top"
    />
  </div>

  <div class="flex flex-col flex-grow p-4">
    <h3 class="text-xl font-semibold mb-2 line-clamp-2">{title}</h3>
    {description && <p class="text-gray-600 flex-grow line-clamp-3">{description}</p>}
  </div>
</a>
