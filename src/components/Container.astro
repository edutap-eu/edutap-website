---
interface Props {
  size?: "sm" | "md" | "lg";
  as?: string;
  class?: string;
}

const { size = "lg", as: Tag = "div", class: className = "" } = Astro.props;

const widths = {
  sm: "max-w-screen-lg",
  md: "max-w-screen-xl",
  lg: "max-w-screen-2xl",
} as const;

const width = widths[size as "sm" | "md" | "lg"];

// The original container.tsx composed classes with cva, which concatenates
// rather than resolving conflicts. Container has no variants of its own to
// let a caller override, so it must concatenate too: using cn() (twMerge)
// here treats e.g. Hero's "pt-48 py-36" as conflicting with nothing of its
// own, but ALSO resolves "pt-48" vs "py-36" against each other as if they
// were the same utility group, silently dropping pt-48. Plain concatenation
// matches the original, non-merging behaviour.
---

<Tag class={`container mx-auto px-4 sm:px-6 lg:px-8 ${width} ${className}`}>
  <slot />
</Tag>
