---
type Size = "sm" | "md" | "lg";

// Exported so TypeScript sees the interface as used: Astro applies it to
// `Astro.props` implicitly, which the checker cannot follow, and otherwise
// reports it as declared but never used. `as` stays a plain string - typing
// it as a union of element names would make `<Tag>` below no longer resolve
// to a single component for the checker.
export interface Props {
  size?: Size;
  /** The element to render as, e.g. "section" or "footer". */
  as?: string;
  class?: string;
}

const { size = "lg", as: Tag = "div", class: className = "" } = Astro.props;

const widths = {
  sm: "max-w-screen-lg",
  md: "max-w-screen-xl",
  lg: "max-w-screen-2xl",
} as const;

// `Astro.props` is not statically typed here (see the note on `Props`), so
// `size` arrives as `any` and has to be narrowed before it can index `widths`.
const width = widths[size as Size];

// The original container.tsx composed classes with cva, which concatenates
// rather than resolving conflicts. Container has no variants of its own to
// let a caller override, so it must concatenate too: using cn() (twMerge)
// here treats e.g. Hero's "pt-48 py-36" as conflicting with nothing of its
// own, but ALSO resolves "pt-48" vs "py-36" against each other as if they
// were the same utility group, silently dropping pt-48. Plain concatenation
// matches the original, non-merging behaviour.
---

<Tag class={`container mx-auto px-4 sm:px-6 lg:px-8 ${width} ${className}`}>
  <slot />
</Tag>
