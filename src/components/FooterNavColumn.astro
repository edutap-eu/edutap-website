---
interface Link {
  href: string;
  label: string;
}

interface Props {
  title: string;
  links: Link[];
}

const { title, links } = Astro.props;
---

<div>
  <h4 class="font-semibold mb-4">{title}</h4>
  <ul class="space-y-2">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-sm text-gray-300 hover:underline hover:text-white transition-colors"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</div>
