---
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}
const { orientation = "horizontal", class: className = "" } = Astro.props;
---

<div
  data-slot="separator-root"
  data-orientation={orientation}
  role="separator"
  aria-orientation={orientation}
  class={`bg-border shrink-0 data-[orientation=horizontal]:h-px data-[orientation=horizontal]:w-full data-[orientation=vertical]:h-full data-[orientation=vertical]:w-px ${className}`}
>
</div>
