---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const hasHeader =
  Astro.slots.has("title") ||
  Astro.slots.has("description") ||
  Astro.slots.has("action");
---

<div
  data-slot="card"
  class={`bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm ${className}`}
>
  {
    hasHeader && (
      <div
        data-slot="card-header"
        class="@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-1.5 px-6 has-[data-slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6"
      >
        {Astro.slots.has("title") && (
          <div data-slot="card-title" class="leading-none font-semibold">
            <slot name="title" />
          </div>
        )}
        {Astro.slots.has("description") && (
          <div
            data-slot="card-description"
            class="text-muted-foreground text-sm"
          >
            <slot name="description" />
          </div>
        )}
        {Astro.slots.has("action") && (
          <div
            data-slot="card-action"
            class="col-start-2 row-span-2 row-start-1 self-start justify-self-end"
          >
            <slot name="action" />
          </div>
        )}
      </div>
    )
  }
  <div data-slot="card-content" class="px-6">
    <slot />
  </div>
  {
    Astro.slots.has("footer") && (
      <div
        data-slot="card-footer"
        class="flex items-center px-6 [.border-t]:pt-6"
      >
        <slot name="footer" />
      </div>
    )
  }
</div>
